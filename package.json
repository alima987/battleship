{
    "name": "ws_task",
    "version": "1.0.0",
    "description": "Template for the WebSocket remote control task",
    "main": "index.ts",
    "type": "module",
    "scripts": {
        "start": "node --loader ts-node/esm index.ts",
        "start:dev": "nodemon ./index.ts",
        "test": "echo \"Error: no test specified\" && exit 1",
        "wss": "node --loader ts-node/esm src/ws/server.ts"
    },
    "author": "Andrei Auchynnikau",
    "keywords": [],
    "license": "ISC",
    "devDependencies": {
        "@types/node": "^22.15.17",
        "@types/ws": "^8.18.1",
        "nodemon": "^2.0.16",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.3"
    },
    "dependencies": {
        "ws": "^8.18.2"
    },
    "compilerOptions": {
        "outDir": "./dist",
        "jsx": "react-jsx",
        "lib": [
            "es6",
            "dom"
        ],
        "sourceMap": true,
        "module": "ESNext",
        "moduleResolution": "Node",
        "target": "es6",
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true
    },
    "engines": {
        "node": ">=18.0.0"
    }
}